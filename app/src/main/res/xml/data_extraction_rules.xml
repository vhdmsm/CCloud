<?xml version="1.0" encoding="utf-8"?><!--
   Sample data extraction rules file; uncomment and customize as necessary.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   for details.
-->
<data-extraction-rules>
    <cloud-backup>
        <!-- The shared movie data settings hold the publisher's GitHub token: kept on the device only -->
        <exclude domain="sharedpref" path="metadata_snapshot.xml"/>
        <!-- API keys saved by the owner's build: kept on the device only -->
        <exclude domain="sharedpref" path="api_keys.xml"/>
        <!-- TODO: Use <include> and <exclude> to control what is backed up.
        <include .../>
        <exclude .../>
        -->
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="metadata_snapshot.xml"/>
        <!-- API keys saved by the owner's build: kept on the device only -->
        <exclude domain="sharedpref" path="api_keys.xml"/>
    </device-transfer>
</data-extraction-rules>