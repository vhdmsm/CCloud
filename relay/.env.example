# Copy to .env and fill in. Never commit .env.

# Domain pointing at this server (an A record), e.g. api.example.com
RELAY_DOMAIN=api.example.com

# Same value as the RELAY_TOKEN repository secret; the app sends it with every request
RELAY_TOKEN=

OMDB_API_KEY=
OMDB_API_KEY2=
OMDB_API_KEY3=

# Requests per app user (IP) per minute
RATE_LIMIT_PER_MINUTE=120

# Ports on the server; change HTTPS_PORT (e.g. 8443) if 443 is already in use
HTTP_PORT=80
HTTPS_PORT=443
